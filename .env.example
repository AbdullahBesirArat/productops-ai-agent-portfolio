# Documentation only. Supply secrets locally; never commit real values.
# Empty HOST/PORT/MODEL_ADAPTER use local defaults.
HOST=
PORT=
MODEL_ADAPTER=
# Runtime URL: productops_app, productops_dev, local host only.
PRODUCTOPS_DB_URL=
# Migration URL: productops_migrator, productops_dev.
PRODUCTOPS_MIGRATOR_DB_URL=
# Tests require 127.0.0.1:54329/productops_test and the named role.
PRODUCTOPS_TEST_DB_URL=
PRODUCTOPS_MIGRATOR_TEST_DB_URL=
# Compose bootstrap superuser password; never used by the app.
PRODUCTOPS_DB_PASSWORD=
PRODUCTOPS_MIGRATOR_PASSWORD=
PRODUCTOPS_APP_PASSWORD=

# Bootstrap CLI kimli?i; HTTP uygulamas?na verilmez.
PRODUCTOPS_BOOTSTRAP_PASSWORD=
PRODUCTOPS_BOOTSTRAP_DB_URL=
PRODUCTOPS_BOOTSTRAP_TEST_DB_URL=
# 64 hex karakter; 32 bayt.
# Used only for persisted agent request fingerprints, never for JWT.
PRODUCTOPS_REQUEST_DIGEST_SECRET=
PRODUCTOPS_AUTH_PASSWORD=
PRODUCTOPS_AUTH_DB_URL=
PRODUCTOPS_AUTH_TEST_DB_URL=
# Sentetik demo hesaplar?n?n ortak parolas?.
PRODUCTOPS_DEMO_PASSWORD=
