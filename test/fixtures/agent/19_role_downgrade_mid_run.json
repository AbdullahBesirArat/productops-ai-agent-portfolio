{
  "name": "19_role_downgrade_mid_run",
  "description": "Role is downgraded between calls: the gated second tool is refused under the CURRENT role.",
  "adapter": "scripted",
  "tenant": "A",
  "role": "owner",
  "request": "stock then policy",
  "gated": {
    "tool": "get_policy_snippet",
    "permission": "draft:create"
  },
  "steps": [
    {
      "output": {
        "kind": "tool_call",
        "tool": "list_low_stock_products",
        "arguments": {}
      }
    },
    {
      "hook": "downgrade_to_viewer",
      "output": {
        "kind": "tool_call",
        "tool": "get_policy_snippet",
        "arguments": {
          "topic": "returns"
        }
      }
    }
  ],
  "expect": {
    "status": "forbidden",
    "http": 403,
    "errorCode": "FORBIDDEN",
    "tools": [
      [
        "list_low_stock_products",
        "ok"
      ],
      [
        "get_policy_snippet",
        "forbidden"
      ]
    ]
  }
}
